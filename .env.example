# Supabase Configuration (PostgreSQL Database & Auth)
# Get these from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram Bot API (Used by Vercel Serverless Functions in later phase)
# Do NOT prefix with VITE_ so they are NEVER exposed to client-side bundles!
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-target-channel-or-group-id
