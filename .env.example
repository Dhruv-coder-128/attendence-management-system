# SMS — Student Management System
# Copy to .env.local and fill with your values. Never commit real secrets.

# --- Required: Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only (Vercel env): service role key for privileged APIs
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_URL=https://your-project.supabase.co

# --- Production API (for Tauri/Capacitor) ---
VITE_PRODUCTION_API_URL=https://your-app.vercel.app
# Optional allowlist for CORS (comma-separated)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://admin.your-app.vercel.app

# --- Admin Console auth (server verifies; choose ONE) ---
# Hashed PIN (sha256 hex) — generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PIN').digest('hex'))"
ADMIN_PIN_HASH=replace_with_sha256_of_your_pin
# Or plain PIN for initial setup (replace with hash in prod)
ADMIN_PIN=replace_me
# Allowed admin emails (comma-separated)
MASTER_ADMIN_EMAILS=admin@your-school.edu
DEVELOPER_SECRET=random_long_secret_for_header_auth

# --- Branding / Support contact (dynamic via DB academy_settings.support_contact, env is fallback) ---
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_SUPPORT_EMAIL=support@your-school.edu
VITE_SUPPORT_WHATSAPP=+91 98765 43210
VITE_APP_NAME=SMS — Student Management System

# --- Optional: Telegram ---
TELEGRAM_BOT_TOKEN=xxx
VITE_TELEGRAM_BOT_TOKEN=xxx

# Rotation: update ADMIN_PIN_HASH and SUPABASE_SERVICE_ROLE_KEY in Vercel dashboard, redeploy, then clear old keys.
