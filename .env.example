# =====================================================================
# RUPAREL ATTENDANCE ERP — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# NOTE: .env.local is ignored by Git, protecting your private secrets.
# =====================================================================

# 1. SUPABASE DATABASE & AUTH CONFIGURATION
# Obtain from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# (Optional for local backend functions) Supabase Service Role Secret Key
# Used strictly on the server in api/ routes to bypass RLS policies.
# NEVER prefix with VITE_ so it is NEVER bundled into the client browser!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. TELEGRAM BOT API CONFIGURATION (SERVER-SIDE ONLY)
# Used by Vercel Serverless Functions (/api/telegram-*) to communicate with Telegram.
# NEVER prefix with VITE_!
# For local testing: Create a separate test bot with @BotFather and place its token here.
# NEVER use your production bot token for local testing to avoid webhook collisions!
TELEGRAM_BOT_TOKEN=your-test-bot-token-from-botfather

# 3. TELEGRAM BOT USERNAME (CLIENT-SIDE SAFE)
# Public handle of your bot without the '@' prefix (e.g., RuparelAttendanceBot or MyDevTestBot).
# Used by the frontend to format deep links (https://t.me/<username>?start=tk_...).
# Defaults to RuparelAttendanceBot if omitted.
VITE_TELEGRAM_BOT_USERNAME=your_test_bot_username_without_at
